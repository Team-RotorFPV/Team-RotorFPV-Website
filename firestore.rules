rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
          && request.auth.token.admin == true;
    }

    function isSuperAdmin() {
      return request.auth != null
          && request.auth.token.superAdmin == true;
    }

    function isInventoryAdmin() {
      return request.auth != null && 
        (request.auth.token.admin == true || request.auth.token.superAdmin == true || request.auth.token.inventory == true);
    }

    match /achievements/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /gallery/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /team_members/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /team_years/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /public_board_profiles/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /sponsors/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /events/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /drones/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /contact_messages/{docId} {
      allow read, write: if isAdmin();
    }

    // Same membership test as the server's isActiveMember() (server/auth.js):
    // a users/{email} doc that is not archived, not deactivated, and has no
    // status other than 'active' (legacy docs without a status count as active).
    // Email-matched rules only trust a verified address. Google sign-in always
    // verifies, but if email/password sign-in is ever enabled, an unverified
    // account registered under someone else's address must not count as them.
    function hasVerifiedEmail() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function isActiveTeamMember() {
      let path = /databases/$(database)/documents/users/$(request.auth.token.email.lower());
      let user = get(path).data;
      return hasVerifiedEmail()
        && exists(path)
        && user.get('isArchived', false) != true
        && user.get('isActive', true) != false
        && user.get('status', 'active') in ['active', ''];
    }

    function isOptionalString(data, field, maxLen) {
      return !(field in data)
        || data[field] == null
        || (data[field] is string && data[field].size() <= maxLen);
    }

    // Append-only audit trail written by every app's logAdminAction().
    // Only verified team members (or admins) may write, only under their own
    // email, with the fixed field set. No one can edit or delete an entry.
    // `timestamp` is still the client's ISO string so already-installed app
    // builds keep logging; a server timestamp (== request.time) is also
    // accepted so clients can move to serverTimestamp() later.
    match /activity_logs/{docId} {
      allow read: if isAdmin();
      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && (isAdmin() || isSuperAdmin() || isActiveTeamMember())
        && request.resource.data.keys().hasOnly(['userEmail', 'actionType', 'targetType', 'details', 'timestamp'])
        && request.resource.data.userEmail == request.auth.token.email
        && request.resource.data.actionType is string
        && request.resource.data.actionType.size() > 0
        && request.resource.data.actionType.size() <= 100
        && isOptionalString(request.resource.data, 'targetType', 300)
        && isOptionalString(request.resource.data, 'details', 5000)
        && (request.resource.data.timestamp == request.time
            || (request.resource.data.timestamp is string
                && request.resource.data.timestamp.size() <= 40));
      allow update, delete: if false;
    }

    match /audit_logs/{docId} {
      allow read, create: if isAdmin();
    }

    match /join_requests/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Fields that decide who someone is and what they may do. Tags drive admin
    // and super-admin claims (syncUserPermissions), and status/emailVerified/
    // isActive/isArchived decide team membership (see isActiveTeamMember above
    // and isActiveMember in server/auth.js). Only super admins (or the server's
    // Admin SDK) may change them.
    function permissionFields() {
      return ['tags', 'tagNames', 'permissions', 'isAdmin', 'isSuperAdmin', 'boardGroup',
              'status', 'emailVerified', 'isActive', 'isArchived'];
    }

    function isSelf(docId) {
      return hasVerifiedEmail() && request.auth.token.email.lower() == docId;
    }

    match /users/{docId} {
      allow read: if isAdmin() || isInventoryAdmin() || isSelf(docId);
      // Members are provisioned by the server (join-request approval / admin
      // create). A client may only create its own doc if it already holds an
      // admin claim (e.g. the root admin's first profile save), and even then
      // without permission fields — otherwise any Google account could create
      // users/<its email> with status 'active' and pass every membership check.
      allow create: if isSuperAdmin()
        || (isSelf(docId) && isAdmin()
            && !request.resource.data.keys().hasAny(permissionFields()));
      // Regular admins can edit other users' profile details, but never
      // permission fields: otherwise an admin could tag someone (or set up a
      // future promotion) as Super Admin. Users can edit their own profile,
      // again without permission fields.
      allow update: if isSuperAdmin()
        || ((isAdmin() || isSelf(docId))
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(permissionFields()));
      allow delete: if isSuperAdmin();
    }

    // Tag definitions carry grantsAdmin / grantsSuperAdmin / grantsTags, so
    // editing one is the same as granting permissions to everyone who holds it.
    match /tags/{docId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    match /custom_fields/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /inventory_lists/{docId} {
      allow read, write: if isInventoryAdmin();
    }

    match /inventories/{docId} {
      allow read, write: if isInventoryAdmin();
    }

    match /items/{docId} {
      allow read, write: if isInventoryAdmin();
    }

    match /inventory_hold_history/{docId} {
      allow read, write: if isInventoryAdmin();
    }

    match /item_history/{docId} {
      allow read, write: if isInventoryAdmin();
    }

    match /inventory_movement_history/{docId} {
      allow read, write: if isInventoryAdmin();
    }

    match /social_links/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Physical QR asset tags. Gated to inventory admins, consistent with the
    // inventories/items collections. Enforces the tag lifecycle:
    //   unassigned -> active (bind, immutable binding) -> retired.
    // A bound tag can never be re-pointed; tags are retired, never deleted.
    // This also resolves the offline race: two devices binding the same
    // unassigned tag → first to reach the server wins, the second fails the
    // status == 'unassigned' precondition on sync.
    match /asset_tags/{code} {
      function isBindTransition() {
        return resource.data.status == 'unassigned'
          && request.resource.data.status == 'active'
          && request.resource.data.entityId != null
          && (request.resource.data.entityType == 'inventory'
              || request.resource.data.entityType == 'item');
      }
      function isRetireTransition() {
        return resource.data.status == 'active'
          && request.resource.data.status == 'retired'
          && request.resource.data.entityId == resource.data.entityId
          && request.resource.data.entityType == resource.data.entityType;
      }
      allow read: if isInventoryAdmin();
      allow create: if isInventoryAdmin()
        && request.resource.data.status == 'unassigned'
        && request.resource.data.entityId == null
        && request.resource.data.entityType == null;
      allow update: if isInventoryAdmin() && (isBindTransition() || isRetireTransition());
      allow delete: if false;
    }

    // Deny everything else by default.
    // Any new collection must have explicit rules added above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
